---
import { Image } from "astro:assets";
import { render } from "astro:content";
import BackLink from "@/components/blog/BackLink.astro";
import BlogHeading from "@/components/blog/BlogHeading.astro";
import Badge from "@/components/ui/badge.astro";
import { Separator } from "@/components/ui/separator";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getBlogPostTags, getBlogPostUrl, getBlogTagUrl, getPublishedBlogPosts } from "@/lib/blog";
import { getAbsoluteUrl, siteConfig } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();

  return posts.map((post) => ({
    params: { slug: getBlogPostUrl(post).replace("/blog/", "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = getBlogPostTags(post);
const postUrl = getBlogPostUrl(post);
const postDescription = post.data.description || post.data.title;
const postImage = post.data.image?.src ?? siteConfig.defaultSocialImage;
const blogPostStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: postDescription,
  image: getAbsoluteUrl(postImage),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: siteConfig.name,
    url: siteConfig.url,
    sameAs: siteConfig.sameAs,
  },
  publisher: {
    "@type": "Person",
    name: siteConfig.name,
    url: siteConfig.url,
  },
  mainEntityOfPage: getAbsoluteUrl(`${postUrl}/`),
  keywords: tags.map((tag) => tag.label),
};
---

<BlogLayout
  title={`${post.data.title} | Kai Sheng`}
  description={postDescription}
  canonicalPath={`${postUrl}/`}
  ogType="article"
  noIndex={post.data.draft === true}
  socialImage={postImage}
  structuredData={blogPostStructuredData}
>
  <article>
    <header class="max-w-2xl py-8 md:py-12">
      <BackLink href="/blog" label="Back to blog" />
      <BlogHeading>{post.data.title}</BlogHeading>
      <ul class="mt-3 flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <li>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </li>
        {tags.length > 0 && (
          <>
            <li aria-hidden="true">
              <Separator orientation="vertical" />
            </li>
            <li>
              <ul class="flex list-none flex-wrap gap-2" aria-label="Tags">
                {tags.map((tag) => (
                  <li>
                    <Badge as="a" href={getBlogTagUrl(tag.slug)} variant="outline">
                      {tag.label}
                    </Badge>
                  </li>
                ))}
              </ul>
            </li>
          </>
        )}
      </ul>
      {post.data.description && (
        <p class="mt-4 text-lg text-muted-foreground leading-relaxed">{post.data.description}</p>
      )}
    </header>

    {post.data.image && (
        <Image
          src={post.data.image}
          alt=""
          class="mb-8 aspect-[16/9] w-full rounded-lg border object-cover"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 768px) 768px, calc(100vw - 2rem)"
        />
      )}

    <Separator />

    <div class="blog-prose pb-8"><Content /></div>
  </article>
</BlogLayout>
